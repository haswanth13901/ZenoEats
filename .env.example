# ─────────────────────────────────────────────
# ZenoEats environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# ─────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, keep secret

# Stripe (Dashboard → Developers → API keys). Use test keys for now.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Twilio (Console). Trial mode works to verified numbers only.
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Google Maps Platform (Cloud Console → Credentials)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-key
