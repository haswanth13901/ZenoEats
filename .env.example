# ─────────────────────────────────────────────
# ZenoEats environment variables
# Copy to .env.local and fill in. NEVER commit real values.
#
# NEXT_PUBLIC_* is inlined into the browser bundle at build time — treat every
# one of them as public. Everything else is server-only.
# ─────────────────────────────────────────────

# App — used for Stripe redirect URLs and the tracking link in the SMS.
# Must be the real origin in production, or customers get links to localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS entirely — it is the key the checkout route, the
# Stripe webhook and the customer tracking page use. Never import it into a
# client component, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection, for applying migrations with psql.
# Supabase dashboard → Connect → Session pooler (or Direct connection).
# Not read by the app at runtime — tooling only. Optional.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Stripe ──────────────────────────────────
# Dashboard → Developers → API keys. Use test keys until go-live.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Developers → Webhooks → your endpoint → Signing secret.
# Locally: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# prints a whsec_ that is DIFFERENT from the dashboard one — use the CLI's.
# Without this the webhook returns 500 rather than trusting unsigned payloads.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Twilio ──────────────────────────────────
# Console → Account Info. Trial accounts only send to verified numbers; real
# US business SMS needs A2P 10DLC registration (see docs/SETUP.md).
# If these are absent the app still runs — the tracking SMS is skipped with a
# warning rather than failing the paid order.
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Google Maps ─────────────────────────────
# Cloud Console → Credentials. Enable Maps JavaScript API + Directions API,
# and restrict the key to your domain — it ships to the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-key

# ─── Upstash Redis (Phase 4) ─────────────────
# console.upstash.com → your database → REST API.
# Used for Stripe webhook idempotency, rate limiting on /api/checkout and the
# webhook, and a short-TTL menu cache.
#
# Both are OPTIONAL. With them absent the app boots and works normally:
# rate limiting is skipped and webhook idempotency falls back to the
# conditional database update, which is the real guarantee anyway. Set them in
# production — without Redis there is no protection against request floods.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
